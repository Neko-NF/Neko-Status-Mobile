<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snapshot_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/snapshot_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/neko_legacy_icon" />

            <TextView
                android:id="@+id/snapshot_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#E5E2E6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/snapshot_widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_never"
                android:textColor="#C7C6CA"
                android:textSize="9sp" />

            <FrameLayout
                android:id="@+id/snapshot_widget_refresh_container"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/snapshot_widget_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_refresh"
                    android:padding="7dp"
                    android:src="@drawable/ic_widget_refresh" />

                <ProgressBar
                    android:id="@+id/snapshot_widget_refresh_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_refreshing"
                    android:indeterminate="true"
                    android:indeterminateTint="#73D8E2"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/snapshot_widget_image_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_snapshot_frame"
            android:padding="2dp">

            <ImageView
                android:id="@+id/snapshot_widget_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_device_screenshot"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/snapshot_widget_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="20dp"
                android:text="@string/widget_no_screenshot"
                android:textColor="#C7C6CA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/snapshot_widget_stale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/widget_stale_badge"
                android:text="@string/widget_cached_screenshot"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/snapshot_widget_info"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/snapshot_widget_app_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_neko_monochrome" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/snapshot_widget_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E5E2E6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/snapshot_widget_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C7C6CA"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/snapshot_widget_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C7C6CA"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/snapshot_widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/widget_status_dot_offline"
                    android:drawablePadding="4dp"
                    android:textColor="#73D8E2"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/snapshot_widget_battery_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/snapshot_widget_battery_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/widget_battery_icon"
                        android:src="@drawable/ic_widget_battery_full" />

                    <TextView
                        android:id="@+id/snapshot_widget_battery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="#73D8E2"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
