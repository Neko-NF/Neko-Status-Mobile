<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:text="@string/widget_snapshot_preview_title"
        android:textColor="#E5E2E6"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_snapshot_frame"
        android:gravity="center"
        android:text="@string/widget_device_screenshot"
        android:textColor="#C7C6CA"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="@string/widget_snapshot_preview_device"
        android:textColor="#E5E2E6"
        android:textSize="11sp" />
</LinearLayout>
